# ---- Server ----
PORT=8080
NODE_ENV=production
# Comma-separated origins allowed to call the API (your Vercel URL + localhost)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ---- Target store ----
STORE_BASE_URL=https://demo.inelabteamdev.com

# ---- Supabase ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service-role key. Backend only. Never ship this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Cron protection ----
# cron-job.org must send: x-cron-secret: <this value>
CRON_SECRET=change-me-to-a-long-random-string

# ---- Scraper tuning ----
SCRAPE_INTERVAL_MINUTES=120
MAX_ATTEMPTS=4
REQUEST_TIMEOUT_MS=12000
RETRY_BASE_DELAY_MS=800
RETRY_MAX_DELAY_MS=8000
# Reject a new price that deviates more than this fraction from the last known
# good price unless a second independent fetch confirms it. 0 disables.
PRICE_SANITY_DEVIATION=0.75
# Allow falling back to a headless browser when HTTP+parse cannot extract
USE_BROWSER_FALLBACK=true
BROWSER_TIMEOUT_MS=25000

# ---- Optional selector overrides (only if auto-detection needs help) ----
# PRICE_SELECTOR=.product-price
# STOCK_SELECTOR=.availability
# PRODUCT_CARD_SELECTOR=.product-card

# ---- Alerts (bonus, optional) ----
SENDGRID_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
